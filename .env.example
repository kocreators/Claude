# Postgres connection string (Neon, Supabase, RDS, local Docker, etc.)
DATABASE_URI=postgresql://user:password@localhost:5432/kocreators

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL, used for absolute links, sitemaps, previews
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret for the inbound webhook listener at POST /api/webhooks.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-long-random-string

# Where webhook notifications go. Optional — defaults to the email address
# set in the Payload admin under Site Settings.
WEBHOOK_NOTIFY_EMAIL=you@yourdomain.com

# Transactional email (used by the contact forms and the webhook listener)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kocreators <hello@yourdomain.com>

# Smartlead posts to /api/webhooks/smartlead?token=... — it can't sign its
# webhooks, so this URL token is the authentication. Rotate it by changing
# this value and updating the URL in Smartlead.
# Generate with: openssl rand -hex 24
SMARTLEAD_WEBHOOK_TOKEN=

# Which Smartlead events trigger an email. Optional — defaults to
# EMAIL_REPLY,EMAIL_BOUNCE,LEAD_CATEGORY_UPDATED. Sends/opens/clicks are
# acknowledged but not emailed, so the inbox stays useful.
SMARTLEAD_NOTIFY_EVENTS=
